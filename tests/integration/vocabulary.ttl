@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <https://example.org/concept/> .
ex:scheme a skos:ConceptScheme ; skos:prefLabel "Test vocabulary"@en ; skos:hasTopConcept ex:art .
ex:art a skos:Concept ; skos:inScheme ex:scheme ; skos:topConceptOf ex:scheme ;
  skos:prefLabel "Art"@en, "Kunst"@de ; skos:narrower ex:modernArt .
ex:modernArt a skos:Concept ; skos:inScheme ex:scheme ; skos:broader ex:art ;
  skos:prefLabel "Modern art"@en, "Moderne Kunst"@de ;
  skos:altLabel "Contemporary fine arts"@en ; skos:hiddenLabel "Modren art"@en ;
  skos:notation "A.01" ; skos:exactMatch <https://example.net/concept/modern-art> .
ex:collection a skos:Collection ; skos:prefLabel "Art collection"@en ; skos:member ex:art, ex:modernArt .
