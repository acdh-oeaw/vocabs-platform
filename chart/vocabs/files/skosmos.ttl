@prefix skosmos: <http://purl.org/net/skosmos#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
<#config> a skosmos:Configuration ;
  {{- if .Values.global.publicUrl }}
  skosmos:baseHref {{ (include "vocabs.public" . | fromYaml).url | quote }} ;
  {{- end }}
  skosmos:serviceName "ACDH Vocabs (development)" ;
  skosmos:customCss "resource/css/acdh/acdh-vocabs.css" ;
  skosmos:sparqlEndpoint <http://{{ include "vocabs.fullname" . }}-vinyl:{{ .Values.vinyl.service.port }}/skosmos/sparql> ;
  skosmos:sparqlDialect "JenaText" ;
  skosmos:languages ( [ rdfs:label "en" ; rdf:value "en_GB.utf8" ] [ rdfs:label "de" ; rdf:value "de_DE.utf8" ] ) ;
  skosmos:templateCache "/tmp/skosmos-template-cache" .
